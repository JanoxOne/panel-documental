<%- include('head', { title }) %>
<body class="app">
  <aside class="sidebar" id="sidebar" aria-label="Menú principal">
    <a class="sidebar-brand" href="/panel">
      <span class="brand-mark"><%- include('icon', { name: 'doc' }) %></span>
      <span>Panel Documental</span>
    </a>
    <nav>
      <ul>
        <li><a href="/panel" class="<%= active === 'inicio' ? 'active' : '' %>"<%- active === 'inicio' ? ' aria-current="page"' : '' %>><%- include('icon', { name: 'home' }) %><span>Inicio</span></a></li>
        <% for (const item of menu) { %>
          <li>
            <a href="/panel/<%= item.slug %>" class="<%= active === item.slug ? 'active' : '' %>"<%- active === item.slug && !locals.carpetaActual ? ' aria-current="page"' : '' %>><%- include('icon', { name: item.icon }) %><span><%= item.label %></span></a>
            <% if (item.slug === 'bandeja-entrada' && active === 'bandeja-entrada' && locals.carpetas) { %>
              <ul class="submenu">
                <% for (const c of carpetas) { %>
                  <li><a href="/panel/bandeja-entrada/<%= c.slug %>" class="<%= locals.carpetaActual === c.slug ? 'active' : '' %>"<%- locals.carpetaActual === c.slug ? ' aria-current="page"' : '' %>>
                    <span><%= c.label %></span>
                    <% const b = insignia(c, conteos[c.slug]); if (b.n) { %><span class="count<%= b.destacada ? ' count-new' : '' %>" title="<%= b.n %> <%= b.titulo %>"><%= b.n %></span><% } %>
                  </a></li>
                <% } %>
              </ul>
            <% } %>
          </li>
        <% } %>
      </ul>
    </nav>
    <form method="post" action="/logout" class="sidebar-logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit"><%- include('icon', { name: 'logout' }) %><span>Cerrar sesión</span></button>
    </form>
  </aside>
  <div class="backdrop" id="backdrop" hidden></div>

  <div class="main">
    <header class="topbar">
      <button type="button" class="menu-toggle" id="menu-toggle" aria-controls="sidebar" aria-expanded="true" aria-label="Mostrar u ocultar menú">
        <%- include('icon', { name: 'menu' }) %>
      </button>
      <h1 class="topbar-title"><%= title %></h1>
      <div class="topbar-user">
        <span class="avatar"><%= currentUser.full_name.charAt(0).toUpperCase() %></span>
        <span class="topbar-user-name"><%= currentUser.full_name %></span>
      </div>
    </header>
    <main class="content">
